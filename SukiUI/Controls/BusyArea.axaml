<UserControl x:Class="SukiUI.Controls.BusyArea"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="clr-namespace:SukiUI.Controls"
             xmlns:converters="https://github.com/kikipoulet/SukiUI">
    <UserControl.Styles>
        <!-- Block only this area's content; sibling navigation and Cancel remain usable. -->
        <Style Selector="suki|BusyArea[IsBusy=True] /template/ ContentControl#BusyContent">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Effect"><BlurEffect Radius="3" /></Setter>
        </Style>
        <Style Selector="suki|BusyArea /template/ Button#PART_CancelButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="suki|BusyArea[IsBusy=True][IsCancelVisible=True] /template/ Button#PART_CancelButton">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="suki|BusyArea">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <ContentControl Name="BusyContent" Content="{TemplateBinding Content}"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                        <Border Name="PART_BusyOverlay" Background="#40000000">
                            <Border.IsVisible>
                                <!-- Hide a nested indicator when an enclosing busy area disables it. -->
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsBusy" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <Border Name="PART_BusyCard" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="420" Margin="8" Padding="12" CornerRadius="8"
                                    Background="{DynamicResource SukiCardBackground}"
                                    BorderBrush="{DynamicResource SukiControlBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Name="PART_BusyText" FontWeight="{DynamicResource DefaultDemiBold}"
                                               TextAlignment="Center" TextWrapping="Wrap" Text="{TemplateBinding BusyText}"
                                               IsVisible="{TemplateBinding BusyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <ProgressBar Name="PART_ProgressBar" MinWidth="120" Height="4" Minimum="0" Maximum="100"
                                                 Value="{TemplateBinding Progress}" IsHitTestVisible="False"
                                                 IsIndeterminate="{TemplateBinding Progress, Converter={x:Static converters:DoubleConvert.InvalidProgressToBool}}">
                                        <ProgressBar.IsVisible>
                                            <!-- Hidden with the overlay so the ProgressBar theme drops its indeterminate animations; merely paused, they keep the frame clock running. -->
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="IsBusy" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="IsEffectivelyEnabled" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </ProgressBar.IsVisible>
                                    </ProgressBar>
                                    <Button Name="PART_CancelButton" HorizontalAlignment="Center" Classes="Flat"
                                            Content="Cancel" Command="{TemplateBinding CancelCommand}" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
</UserControl>
